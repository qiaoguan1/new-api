FROM oven/bun:1 AS frontend
WORKDIR /build
COPY web/default/package.json web/default/bun.lock ./
RUN bun install --frozen-lockfile
COPY web/default/ ./
ARG VERSION=issue173-quota-authority
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN VITE_REACT_APP_VERSION=$VERSION bun run build

FROM golang:1.26.1-alpine AS backend
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOMAXPROCS=2 GOMEMLIMIT=1800MiB
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=frontend /build/dist ./web/default/dist
RUN mkdir -p web/classic/dist && cp web/default/dist/index.html web/classic/dist/index.html
RUN go build -ldflags '-s -w -X github.com/QuantumNous/new-api/common.Version=issue173-quota-authority' -o /new-api .

FROM new-api-fixed:issue157-stream-errors-72d5a71c
COPY --from=backend /new-api /new-api
LABEL com.aixingtuyun.base-source=72d5a71c807a8aab2be3c8f1417169416cd39325
