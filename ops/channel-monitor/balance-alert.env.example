# The monitor reuses the existing NewAPI root access token; do not put the token value here.
UPSTREAM_BALANCE_ALERT_NOTIFY_URL=http://127.0.0.1:3000
UPSTREAM_BALANCE_ALERT_USER_ID=replace-with-root-user-id
UPSTREAM_BALANCE_ALERT_ACCESS_TOKEN_FILE=/opt/ai-api-stack/channel-monitor/newapi-settlement-access-token

# A raw provider balance at or below zero is exhausted. Unknown balances never match.
UPSTREAM_BALANCE_ALERT_THRESHOLD=0
UPSTREAM_BALANCE_ALERT_REMINDER_HOURS=24
UPSTREAM_BALANCE_ALERT_FAILURE_THRESHOLD=3
UPSTREAM_BALANCE_ALERT_NOTIFY_TIMEOUT=15

