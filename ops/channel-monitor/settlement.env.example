# Never commit real values. Store token files mode 0600 on the relay host.
VIDEO_SETTLEMENT_GATEWAY_URL=http://video-job-gateway:8091
VIDEO_SETTLEMENT_TOKEN_FILE=/opt/ai-api-stack/channel-monitor/video-settlement-token

# Optional until ordinary NewAPI task settlement is activated.
NEWAPI_SETTLEMENT_URL=http://new-api:3000
NEWAPI_SETTLEMENT_USER_ID=replace-with-root-user-id
NEWAPI_SETTLEMENT_ACCESS_TOKEN_FILE=/opt/ai-api-stack/channel-monitor/newapi-settlement-access-token
