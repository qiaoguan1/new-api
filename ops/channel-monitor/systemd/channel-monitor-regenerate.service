[Unit]
Description=Regenerate channel monitor data after an administrator change
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=channel-monitor-admin
Group=channel-monitor-admin
SupplementaryGroups=docker
WorkingDirectory=/opt/ai-api-stack
ExecStart=/usr/bin/python3 /opt/ai-api-stack/channel-monitor/scripts/generate-monitor-data.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/ai-api-stack/channel-monitor/data
