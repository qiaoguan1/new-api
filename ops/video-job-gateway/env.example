# Copy to .env on the relay host. Never commit real tokens or upstream keys.
VIDEO_JOB_GATEWAY_TOKEN=replace-with-private-cloud-token
VIDEO_JOB_GATEWAY_HOST_DATA_DIR=/opt/xtai/state/video-job-gateway/data
VIDEO_JOB_GATEWAY_PRICING_URL=http://new-api:3000/api/pricing
VIDEO_JOB_GATEWAY_PRICING_FILE=/app/relay-pricing.json
VIDEO_JOB_GATEWAY_PRICING_GROUP=视频
VIDEO_JOB_GATEWAY_PRICING_TIMEOUT_SECONDS=5
VIDEO_JOB_GATEWAY_PRICING_CACHE_SECONDS=30

# Fail closed by default. Add a provider only after its key, catalog route,
# no-cost contract tests and operator approval are complete.
VIDEO_JOB_GATEWAY_ENABLED_PROVIDERS=toonflow,paisio

VIDEO_JOB_PAISIO_BASE_URL=https://api.paisio.online
VIDEO_JOB_PAISIO_API_KEY=replace-with-paisio-key
VIDEO_JOB_PAISIO_RESULT_HOSTS=api.paisio.online,cdn.paisio.online

VIDEO_JOB_ROLLDEK_BASE_URL=https://rolldek.com
VIDEO_JOB_ROLLDEK_API_KEY=replace-with-rolldek-key
VIDEO_JOB_ROLLDEK_RESULT_HOSTS=rolldek.com

# Upstream execution details remain inside the relay. The gateway obtains the
# customer-facing rate only from XingTu New API and never needs an upstream
# console login or billing token.
VIDEO_JOB_TOONFLOW_BASE_URL=https://api.toonflow.net/v1
VIDEO_JOB_TOONFLOW_API_KEY=replace-with-toonflow-api-key
VIDEO_JOB_TOONFLOW_RESULT_HOSTS=api.toonflow.net

VIDEO_JOB_GATEWAY_MAX_ACTIVE_JOBS=500
VIDEO_JOB_GATEWAY_SUBMIT_CONCURRENCY=20
VIDEO_JOB_GATEWAY_POLL_CONCURRENCY=50
VIDEO_JOB_GATEWAY_STREAM_CONCURRENCY=4
VIDEO_JOB_GATEWAY_POLL_INTERVAL_SECONDS=8
VIDEO_JOB_GATEWAY_MAX_JOB_AGE_SECONDS=28800

VIDEO_JOB_GATEWAY_UNCERTAINTY_WINDOW_SECONDS=600
VIDEO_JOB_GATEWAY_UNCERTAINTY_COUNT_THRESHOLD=2
VIDEO_JOB_GATEWAY_UNCERTAINTY_RATE_PERCENT=1
VIDEO_JOB_GATEWAY_UNCERTAINTY_RATE_MIN_SAMPLES=20

VIDEO_JOB_GATEWAY_RESULT_TTL_SECONDS=259200
VIDEO_JOB_GATEWAY_METADATA_TTL_SECONDS=2592000
VIDEO_JOB_GATEWAY_MAX_STREAM_BYTES=536870912
